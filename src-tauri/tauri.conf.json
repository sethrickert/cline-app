{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cline Chat",
  "version": "1.2.1",
  "identifier": "app.clinechat.windows",
  "build": {
    "beforeDevCommand": "node_modules\\.bin\\vite.cmd",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node_modules\\.bin\\vite.cmd build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cline Chat",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* https://github.com https://api.github.com; img-src 'self' https: asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["bin/cline-chat-sidecar"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installerIcon": "icons/setup/icon.ico" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDRGQzQ5NjRENDQ0OTI2QTcKUldTbkprbEVUWmJFVDZ4K2lYK0YrMGtKeHFPeFRCSDZmcmQ2dlg5OXJpdFZtQ3JJelFIWVRwK1EK",
      "endpoints": ["https://github.com/sethrickert/cline-app/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
